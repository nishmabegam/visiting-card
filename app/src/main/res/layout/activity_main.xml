<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <ImageView
        android:id="@+id/frierenImage"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/frieren"
        android:contentDescription="Frieren"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/nameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Frieren"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mage"
        android:textSize="20sp"
        android:layout_marginBottom="18dp" />

    <TextView
        android:id="@+id/ageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Age: Over 1000 years"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/specialtyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Specialty: Ancient Magic"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/occupationText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Occupation: Mage"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/descriptionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="An elven mage who travels in search of magic."
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginTop="10dp" />

</LinearLayout>